# ---------------------------------------------------------------------------
#  MotoVault – environment configuration
#  Copy to `.env` (repo root or backend/) and adjust. Never commit real values.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Bratislava
# Production only (when DJANGO_DEBUG=false)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
# DJANGO_MEDIA_ROOT=/var/www/motovault/media

# --- Database --------------------------------------------------------------
# Empty = SQLite (backend/db.sqlite3). For PostgreSQL:
# DATABASE_URL=postgres://motovault:password@localhost:5432/motovault
DATABASE_URL=
DB_CONN_MAX_AGE=60

# --- Frontend / CORS -------------------------------------------------------
# Public URL of the Angular site (used for "Zobraziť na webe" links in the admin)
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Branding --------------------------------------------------------------
SITE_NAME=MotoVault

# --- Anti-spam -------------------------------------------------------------
# Max. form submissions (orders, bookings, inquiries, contact) per IP
FORMS_THROTTLE_RATE=5/minute

# --- Workshop / booking rules ----------------------------------------------
WORKSHOP_OPEN_HOUR=8
WORKSHOP_CLOSE_HOUR=17
BOOKING_MAX_DAYS_AHEAD=90
SERVICE_SLOT_CAPACITY=2

# --- E-mail notifications --------------------------------------------------
# Console backend prints e-mails to the terminal during development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@motovault.sk
# Staff address that receives a copy of every new order / booking / inquiry
NOTIFY_EMAIL=
